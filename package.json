{
  "name": "meeting-bot",
  "version": "1.3.0",
  "description": "Run meeting bots for Google Meet, Microsoft Teams and Zoom",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "start": "nodemon --legacy-watch src/index.ts",
    "start:worker": "node dist/index.js",
    "dev": "docker compose up --build",
    "stop": "docker compose down",
    "build": "tsc",
    "start:scheduler": "ts-node src/scheduler/index.ts",
    "test:scheduler": "node -r ts-node/register --test --test-concurrency=1 src/scheduler/*.test.ts",
    "test:bot-camera": "node -r ts-node/register --test src/lib/botCamera.test.ts",
    "test:compression": "node -r ts-node/register --test src/lib/compressRecording.test.ts",
    "lint:scheduler": "eslint \"src/scheduler/**/*.ts\" --max-warnings 0",
    "lint": "eslint \"*/**/*.{js,ts}\" --quiet --fix",
    "start:transcription": "ts-node src/transcription/index.ts",
    "transcription:retry": "ts-node src/transcription/index.ts retry",
    "transcription:status": "ts-node src/transcription/index.ts status",
    "test:transcription": "node -r ts-node/register --test --test-concurrency=1 src/transcription/*.test.ts"
  },
  "keywords": [],
  "author": "screenappai",
  "devDependencies": {
    "@playwright/test": "^1.45.3",
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.1.0",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^5.55.0",
    "@typescript-eslint/parser": "^5.55.0",
    "eslint": "^8.36.0",
    "nodemon": "^3.1.4",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.787.0",
    "@aws-sdk/lib-storage": "^3.876.0",
    "@azure/identity": "^4.13.0",
    "@azure/storage-blob": "^12.29.1",
    "@google-cloud/storage": "^7.16.0",
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fs-extra": "^11.2.0",
    "google-auth-library": "^10.9.1",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.46",
    "playwright": "^1.45.3",
    "playwright-extra": "^4.3.6",
    "playwright-extra-plugin-stealth": "^0.0.1",
    "prom-client": "^15.1.3",
    "puppeteer": "^22.15.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "redis": "^5.8.1",
    "serialize-error": "^12.0.0",
    "ts-node": "^10.9.2",
    "uuid": "^11.1.0",
    "winston": "^3.17.0"
  }
}
