NODE_ENV=development
AUTH_BASE_URL_V2=http://localhost:3001/v2

# Calendar scheduler and private dashboard
# Create an OAuth Web application client with Calendar read-only scopes.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Generate independently: openssl rand -base64 32
SCHEDULER_SECRET=
DASHBOARD_ALLOWED_EMAILS=owner@example.com
# Add your exact HTTPS Tailscale origin after configuring tailscale serve.
DASHBOARD_BASE_URLS=http://localhost:3001
# Optional dashboard mount, for example /meeting-bot. Empty serves the dashboard at /.
# Include this path in both localhost and Tailscale OAuth callback URLs.
SCHEDULER_BASE_PATH=
SCHEDULER_BOT_NAME=Meeting Recorder
SCHEDULER_TEAM_ID=
SCHEDULER_USER_ID=
# Generate independently from SCHEDULER_SECRET and NOTIFY_WEBHOOK_SECRET.
SCHEDULER_BEARER_TOKEN=
SCHEDULER_JOIN_LEAD_SECONDS=60
SCHEDULER_MAX_SNAPSHOT_AGE_SECONDS=300
SCHEDULER_OWNER_EMAIL_ALIASES=
SCHEDULER_STATE_PATH=/data/scheduler-state.json
# Omit SCHEDULER_WORKERS to use the two isolated Compose workers.
# SCHEDULER_WORKERS=[{"id":"1","baseUrl":"http://meeting-bot-1:3000","processingQueue":"jobs:meetbot:processing:1"},{"id":"2","baseUrl":"http://meeting-bot-2:3000","processingQueue":"jobs:meetbot:processing:2"}]

# Meeting recording configuration
MAX_RECORDING_DURATION_MINUTES=180
# Silence detection timeout in minutes (how long to wait before ending due to inactivity)
MEETING_INACTIVITY_MINUTES=2
INACTIVITY_DETECTION_START_DELAY_MINUTES=5
# How long to wait at lobby before timing out (in minutes)
JOIN_WAIT_TIME_MINUTES=2
# Number of retries for transient errors (WaitingAtLobbyRetryError never retries)
# RETRY_COUNT=2 means: 1 initial attempt + 2 retries = 3 total attempts
RETRY_COUNT=2

# Optional persistent browser configuration. CDP is used by Google Meet and Zoom;
# Teams keeps a local profile under CHROME_USER_DATA_DIR for X11/PulseAudio capture.
# CHROME_CDP_URL=http://host.docker.internal:9222
# CHROME_USER_DATA_DIR=/usr/src/app/.chrome
# Optional Google Meet identity (legacy provider-specific settings remain supported).
# Prefer a dedicated, consented Google account that is invited to meetings.
# If you use CDP, launch that Chrome with --auto-accept-this-tab-capture so
# getDisplayMedia can select the current Meet tab without manual confirmation.
# GOOGLE_CHROME_CDP_URL=http://host.docker.internal:9222
# GOOGLE_CHROME_USER_DATA_DIR=/usr/src/app/.chrome/google-meet-profile
# GOOGLE_CHROME_STORAGE_STATE_PATH=/usr/src/app/.chrome/google-meet-storage-state.json
# Re-submit anonymous guest requests if Google redirects while still waiting for host admission.
GOOGLE_ANONYMOUS_JOIN_REQUEST_ATTEMPTS=10

# GCP bucket configuration for uploading debugging screenshots
GCP_ACCESS_KEY_ID=
GCP_SECRET_ACCESS_KEY=
GCP_MISC_BUCKET=
GCP_MISC_BUCKET_FOLDER=meeting-bot
GCP_DEFAULT_REGION=

# For patching the status or logs of bots
SCREENAPP_BACKEND_SERVICE_API_KEY=

# Redis
REDIS_CONSUMER_ENABLED=true
REDIS_QUEUE_NAME=jobs:meetbot:list
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
# Compose overrides REDIS_HOST/PORT to redis:6379 for every service.
# Bundled Redis has no ACL/password: keep REDIS_USERNAME and REDIS_PASSWORD empty.
# docker-compose only: loopback host port for bundled Redis (default 6379).
# Set this if another local Redis already uses 6379, e.g. REDIS_PORT_HOST=6380
# REDIS_PORT_HOST=6380

# Uploader
UPLOADER_FILE_EXTENSION=.webm
UPLOADER_TYPE=s3

# Storage provider selection: 's3' (default) or 'azure'
STORAGE_PROVIDER=s3

# S3 compatible storage for recording upload
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_ENDPOINT=
S3_BUCKET_NAME=
S3_USE_MINIO_COMPATIBILITY=false

# Azure Blob Storage (when STORAGE_PROVIDER=azure)
# Provide ONE of the following auth methods:
# 1. Connection string
AZURE_STORAGE_CONNECTION_STRING=
# 2. Account + Key
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_ACCOUNT_KEY=
# 3. Account + SAS Token (starts with ?sv=)
AZURE_STORAGE_SAS_TOKEN=
# 4. Managed Identity (requires AZURE_STORAGE_ACCOUNT)
AZURE_USE_MANAGED_IDENTITY=false
# Required for Azure
AZURE_STORAGE_CONTAINER=
# Optional Azure settings
AZURE_BLOB_PREFIX=
AZURE_SIGNED_URL_TTL_SECONDS=3600
AZURE_UPLOAD_CONCURRENCY=4

# Scheduler notifications - must use the same shared Redis database as the queue
# Webhook notifications
NOTIFY_WEBHOOK_ENABLED=true
# Compose overrides the callback host to calendar-scheduler.
NOTIFY_WEBHOOK_URL=http://localhost:3001/hooks/recording-completed
# Generate independently: openssl rand -base64 32
NOTIFY_WEBHOOK_SECRET=

# Redis list notifications (for async job processing)
NOTIFY_REDIS_ENABLED=true
# Leave empty: notifications then use the worker queue connection.
NOTIFY_REDIS_URI=
NOTIFY_REDIS_DB=0
NOTIFY_REDIS_LIST=jobs:meetbot:recordings
NOTIFY_REDIS_FAILURE_LIST=jobs:meetbot:failures

# Asynchronous host transcription. Enable only for newly accepted recordings.
TRANSCRIPTION_ENABLED=false
TRANSCRIPTION_CORRECTION_ENABLED=false
# Match the actual REDIS_PORT_HOST published by Compose; do not use Docker DNS here.
TRANSCRIPTION_REDIS_URL=redis://127.0.0.1:6379
TRANSCRIPTION_WHISPERX_ROOT=/home/ibreakshit/Workspace/whisperx
TRANSCRIPTION_AI_ROOT=/home/ibreakshit/Workspace/ai
TRANSCRIPTION_STAGE_TIMEOUT_SECONDS=3600
TRANSCRIPTION_WHISPER_URL=http://127.0.0.1:8090
TRANSCRIPTION_GEMMA_URL=http://127.0.0.1:8091/v1
